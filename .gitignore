# --- DriveWorks source data ---------------------------------------------------
# The group/project snapshot is large (~3.5 GB, mostly SOLIDWORKS CAD) and is
# copied in from the Pro Server group. It is not tracked by default.
/DriveWorks Files/
*.drivepkg
# .spa extractions of builds (client data; the Panels master is 113 MB)
/SPA files/

# --- Tool outputs -------------------------------------------------------------
/work/
/backups/
# project/group copies of each registered export (tracking/exports.json)
/snapshots/
# last export-change notification of the Claude Code hook
/tracking/.hook-state.json

# --- CAD / binary noise anywhere else in the repo ------------------------------
*.sldprt
*.sldasm
*.slddrw
*.drive3d
*.swj
~$*
Thumbs.db
